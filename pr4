<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<title>Лабораторна CSS</title>

<style>

/* ====== ЗАГАЛЬНЕ ====== */
body {
    font-family: Arial;
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    padding: 20px;
}

/* ====== BOX MODEL ====== */

/* 1 спосіб */
.box1 {
    width: 200px;
    height: 200px;
    border: 20px solid blue;
    padding: 20px;
    text-align: center;
    line-height: 160px;
    font-weight: bold;
    background: yellow;
}

/* 2 спосіб */
.box2 {
    width: 200px;
    height: 200px;
    background: yellow;
    outline: 10px solid blue;
    box-shadow: 0 0 0 20px blue;
    text-align: center;
    line-height: 200px;
    font-weight: bold;
}

/* 3 спосіб (псевдоелементи) */
.box3 {
    position: relative;
    width: 200px;
    height: 200px;
    background: yellow;
    text-align: center;
    line-height: 200px;
    font-weight: bold;
}

.box3::before {
    content: "";
    position: absolute;
    top: -20px;
    left: -20px;
    width: 100%;
    height: 100%;
    border: 5px solid blue;
}

.box3::after {
    content: "";
    position: absolute;
    top: 20px;
    left: 20px;
    width: 100%;
    height: 100%;
    border: 5px solid blue;
}

/* ====== ГЕОМЕТРИЧНІ ФІГУРИ ====== */

.square {
    width: 100px;
    height: 100px;
    background: blue;
}

.rectangle {
    width: 150px;
    height: 80px;
    background: yellow;
}

.circle {
    width: 100px;
    height: 100px;
    background: blue;
    border-radius: 50%;
}

.oval {
    width: 150px;
    height: 100px;
    background: yellow;
    border-radius: 50%;
}

.triangle {
    width: 0;
    height: 0;
    border-left: 50px solid transparent;
    border-right: 50px solid transparent;
    border-bottom: 100px solid blue;
}

.diamond {
    width: 100px;
    height: 100px;
    background: yellow;
    transform: rotate(45deg);
}

.parallelogram {
    width: 120px;
    height: 80px;
    background: blue;
    transform: skew(20deg);
}

/* текст всередині */
.shape {
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: bold;
}

</style>
</head>

<body>

<h2>Box Model</h2>

<div class="box1">R.M.</div>
<div class="box2">R.M.</div>
<div class="box3">R.M.</div>

<h2>Геометричні фігури</h2>

<div class="square shape">R.M.</div>
<div class="rectangle shape">R.M.</div>
<div class="circle shape">R.M.</div>
<div class="oval shape">R.M.</div>
<div class="triangle"></div>
<div class="diamond shape">R.M.</div>
<div class="parallelogram shape">R.M.</div>

</body>
</html>
